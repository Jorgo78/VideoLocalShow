<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VideoLocalShow.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VideoLocalShow"
    Title="VideoLocalShow">

    <TabBar>
        <!-- Home is the library of already-downloaded videos; the search / download page is the
             second tab. The routes stay with their pages (MainPage is still where a shared link
             is taken - see MainPage.HandleIncomingLinkAsync). -->
        <ShellContent
            Title="Home"
            Icon="icon_home.png"
            ContentTemplate="{DataTemplate local:DownloadsPage}"
            Route="DownloadsPage" />

        <!-- Content given directly rather than as a ContentTemplate, so MainPage is created when
             the app starts instead of the first time its tab is opened: it is the one that listens
             for shared links (DeepLinkService), which can arrive while another tab is showing. -->
        <ShellContent
            Title="Download"
            Icon="icon_downloads.png"
            Route="MainPage">
            <local:MainPage />
        </ShellContent>

        <!-- TEMP DIAGNOSTIC tab, hidden for now (sharing is confirmed working) - the underlying
             LogPage/ShareDebugLog logging is left in place, paused rather than removed, so it
             can be switched back on quickly by uncommenting this if a new issue needs it.
        <ShellContent
            Title="Log"
            Icon="icon_log.png"
            ContentTemplate="{DataTemplate local:LogPage}"
            Route="LogPage" />
        -->

        <ShellContent
            Title="Info"
            Icon="icon_info.png"
            ContentTemplate="{DataTemplate local:InfoPage}"
            Route="InfoPage" />
    </TabBar>

</Shell>
