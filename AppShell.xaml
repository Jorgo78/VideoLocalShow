<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VideoLocalShow.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VideoLocalShow"
    Title="VideoLocalShow">

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="icon_home.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Download"
            Icon="icon_downloads.png"
            ContentTemplate="{DataTemplate local:DownloadsPage}"
            Route="DownloadsPage" />

        <!-- TEMP DIAGNOSTIC tab - remove once iOS sharing is confirmed reliably working end to end. -->
        <ShellContent
            Title="Log"
            Icon="icon_log.png"
            ContentTemplate="{DataTemplate local:LogPage}"
            Route="LogPage" />
    </TabBar>

</Shell>
