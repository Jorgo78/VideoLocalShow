<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>VideoLocalShow</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<!-- A storyboard entry point, not NSExtensionPrincipalClass pointing straight at the
		     class: this is the pattern from a verified-working community template
		     (VladislavAntonyuk/.NET-Templates dotnet-new ios-share-extension). A direct
		     principal-class reference - tried first, both bare and namespace-qualified - never
		     actually launched the extension on a physical device (appeared in the share sheet,
		     tappable, but silently did nothing every time, confirmed via a log file that never
		     received even its very first line). MainInterface.storyboard's own
		     customClass="ShareViewController" is what resolves the class instead. -->
		<key>NSExtensionMainStoryboard</key>
		<string>MainInterface</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>NSExtensionActivationRule</key>
			<string>TRUEPREDICATE</string>
		</dict>
	</dict>
</dict>
</plist>
