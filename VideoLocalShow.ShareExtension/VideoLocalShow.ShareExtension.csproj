<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-ios</TargetFramework>

		<!-- Library, not Exe: this is the pattern from a verified-working community template
		     (VladislavAntonyuk/.NET-Templates dotnet-new ios-share-extension) after this
		     extension's own storyboard-based entry point (see Info.plist / MainInterface.storyboard)
		     otherwise never launched on a physical device (it appeared in the share sheet, was
		     tappable, and simply did nothing - no crash, no UI, nothing logged - every time).
		     Exe forced an artificial Program.Main stub to exist for no real purpose; Library
		     needs none. -->
		<OutputType>Library</OutputType>

		<RootNamespace>VideoLocalShow.ShareExtension</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

		<!-- Marks this as an iOS app extension rather than a standalone app - the main app's
		     project reference below (with IsAppExtension="true") embeds the resulting bundle
		     into the main app's PlugIns folder at build time. -->
		<IsAppExtension>true</IsAppExtension>
		<IsWatchExtension>false</IsWatchExtension>

		<!-- Also part of the same verified template's configuration - static registration
		     bakes the Objective-C class lookup table in at build time rather than relying on
		     runtime reflection. -->
		<Registrar>static</Registrar>

		<ApplicationId>com.videolocalshowapp.videolocalshow.ShareExtension</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<CodesignEntitlements>Entitlements.plist</CodesignEntitlements>

		<!-- Hardcoded rather than passed down from the main app's build command: a -p: value
		     set there becomes a *global* MSBuild property that would apply to this referenced
		     project too, which is right for CodesignKey (the same distribution certificate
		     signs both) but wrong for CodesignProvision - the two projects have different
		     bundle IDs and need their own distinct provisioning profile. Neither of these
		     values is actually sensitive (both are printed in plain text inside any signed
		     .ipa), so hardcoding them here is no different from what CI would end up needing a
		     secret for anyway. -->
		<CodesignKey>iPhone Distribution: Giorgio Bellante (844CCHUYT5)</CodesignKey>
		<CodesignProvision>VideoLocalShow ShareExtension AppStore</CodesignProvision>
	</PropertyGroup>

</Project>
