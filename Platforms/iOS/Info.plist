<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The app only talks over standard HTTPS (via HttpClient) - no custom/proprietary
	     encryption - so it's exempt from export compliance. Declaring that here means App
	     Store Connect stops asking the encryption-usage question on every single TestFlight
	     upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The app itself never uses Bluetooth, but Apple's validator flags the Bluetooth API
	     symbols referenced by a linked third-party library (media/networking dependencies
	     commonly pull these in even when unused) and requires a purpose string to exist
	     regardless of whether the app's own code calls them. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>VideoLocalShow non utilizza il Bluetooth.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>VideoLocalShow non utilizza il Bluetooth.</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- Custom URL scheme used only to bring this app to the foreground from its own Share
	     Extension - the extension runs as a separate process and can't call back into this
	     app's code directly, so it drops the shared link into an App Group container and then
	     "wakes" the host app via this scheme; AppDelegate.OpenUrl reads it back out from there. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.videolocalshowapp.videolocalshow</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>videolocalshow</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
