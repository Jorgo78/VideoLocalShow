<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VideoLocalShow.InfoPage"
             Title="Info">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="App" FontAttributes="Bold" FontSize="15" Opacity="0.7" />
            <Border Style="{StaticResource Card}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="AppNameLabel" FontAttributes="Bold" FontSize="16" />
                    <Label x:Name="VersionLabel" Style="{StaticResource MutedLabel}" />
                    <Label x:Name="BuildLabel" Style="{StaticResource MutedLabel}" />
                    <Label x:Name="PackageLabel" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Dispositivo" FontAttributes="Bold" FontSize="15" Opacity="0.7" Margin="0,10,0,0" />
            <Border Style="{StaticResource Card}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="PlatformLabel" />
                    <Label x:Name="OsVersionLabel" Style="{StaticResource MutedLabel}" />
                    <Label x:Name="ModelLabel" Style="{StaticResource MutedLabel}" />
                    <Label x:Name="ManufacturerLabel" Style="{StaticResource MutedLabel}" />
                    <Label x:Name="IdiomLabel" Style="{StaticResource MutedLabel}" />
                    <Label x:Name="DeviceTypeLabel" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Schermo" FontAttributes="Bold" FontSize="15" Opacity="0.7" Margin="0,10,0,0" />
            <Border Style="{StaticResource Card}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="ScreenSizeLabel" Style="{StaticResource MutedLabel}" />
                    <Label x:Name="OrientationLabel" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Cartella Download" FontAttributes="Bold" FontSize="15" Opacity="0.7" Margin="0,10,0,0" />
            <Border Style="{StaticResource Card}" Padding="14">
                <Label x:Name="DownloadFolderLabel" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
